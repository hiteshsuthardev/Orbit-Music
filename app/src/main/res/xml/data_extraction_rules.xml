<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-transfer rules for Android 12+.
   The encrypted session is excluded because its Keystore key is device-bound.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
